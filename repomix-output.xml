    private long id;

    @NotBlank(message = "Skill names cannot be left blank!")
    private String name;

    // Quan hệ N-N ngược lại với bảng Job
    @ManyToMany(mappedBy = "skills", fetch = FetchType.LAZY)
    @JsonIgnore
